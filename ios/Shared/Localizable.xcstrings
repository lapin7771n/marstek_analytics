      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-адреса батареї"
          }
        }
      }
    },
    "Battery and ETA": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Батарея і час"
          }
        }
      }
    },
    "Charge and power.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд і потужність."
          }
        }
      }
    },
    "Charge on the Lock Screen.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд на екрані блокування."
          }
        }
      }
    },
    "Charge, power and time until full or empty.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд, потужність і час до повного заряду чи розряду."
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка…"
          }
        }
      }
    },
    "EMPTY IN": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ДО РОЗРЯДУ"
          }
        }
      }
    },
    "ERROR": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПОМИЛКА"
          }
        }
      }
    },
    "ETA": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ЧАС"
          }
        }
      }
    },
    "Enter the battery IP address": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть IP-адресу батареї"
          }
        }
      }
    },
    "FULL": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗАРЯДЖЕНО"
          }
        }
      }
    },
    "FULL IN": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ДО ЗАРЯДУ"
          }
        }
      }
    },
    "IDLE": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПАУЗА"
          }
        }
      }
    },
    "IF OUTAGE": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "БЕЗ СВІТЛА"
          }
        }
      }
    },
    "If it fails": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо не працює"
          }
        }
      }
    },
    "Join the battery's Wi‑Fi, and turn on Open API for the battery in the Marstek app.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до Wi‑Fi батареї й увімкніть Open API для батареї в застосунку Marstek."
          }
        }
      }
    },
    "NO LINK": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "НЕМАЄ ЗВʼЯЗКУ"
          }
        }
      }
    },
    "Now": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз"
          }
        }
      }
    },
    "Open the app": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте застосунок"
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт"
          }
        }
      }
    },
    "Port must be 1 to 65535": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт має бути від 1 до 65535"
          }
        }
      }
    },
    "Privacy policy": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Політика конфіденційності"
          }
        }
      }
    },
    "Reserve ": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резерв "
          }
        }
      }
    },
    "Reserve must be 0 to 50 %": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резерв має бути від 0 до 50 %"
          }
        }
      }
    },
    "SET IP": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ВКАЖІТЬ IP"
          }
        }
      }
    },
    "Save and check": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти й перевірити"
          }
        }
      }
    },
    "Support": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримка"
          }
        }
      }
    },
    "Tap to open Settings and turn on Local Network. If it is not there: Privacy & Security › Local Network.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб відкрити Параметри, і ввімкніть «Локальна мережа». Якщо його там немає: Приватність і безпека › Локальна мережа."
          }
        }
      }
    },
    "The reserve is the charge the battery keeps back. EMPTY IN counts down to it.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резерв — заряд, який батарея не віддає. ДО РОЗРЯДУ рахує час до нього."
          }
        }
      }
    },
    "Updated %@": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлено о %@"
          }
        }
      }
    },
    "h": {
      "comment": "Hours unit, as in 6h20 and 21h",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "год"
          }
        }
      }
    },
    "m": {
      "comment": "Minutes unit, as in 25m",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "хв"
          }
        }
      }
    },
    "−%lld W": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "−%lld Вт"
          }
        }
      }
    }
