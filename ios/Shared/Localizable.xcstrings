      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрачено"
          }
        }
      }
    },
    "Uses the current load. The answer changes as the load changes.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розраховано за поточним навантаженням. Якщо воно зміниться, зміниться й відповідь."
          }
        }
      }
    },
    "YASNO did not answer.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "YASNO не відповідає."
          }
        }
      }
    },
    "YASNO, group %@: emergency outages, no end time.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "YASNO, група %@: аварійні відключення, час завершення невідомий."
