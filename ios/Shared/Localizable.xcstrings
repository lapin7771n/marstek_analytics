    "Looks for Marstek batteries on this Wi‑Fi. It asks each battery once, only when you tap.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає батареї Marstek у цій мережі Wi‑Fi. Звертається до кожної один раз і лише після натискання."
          }
        }
      }
    },
