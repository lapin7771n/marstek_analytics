  "strings": {
    "%@ kWh": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ кВт·год"
          }
        }
      }
    },
    "%@ left, %@. The battery stops at the reserve.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лишилося %1$@, %2$@. Батарея зупиняється на резерві."
          }
        }
      }
    },
    "%@ left. The battery stops at the reserve.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
