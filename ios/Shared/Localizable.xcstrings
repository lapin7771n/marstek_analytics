      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld Вт"
          }
        }
      }
    },
    "ALLOW LAN": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ДОЗВОЛЬТЕ LAN"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про застосунок"
          }
        }
      }
    },
    "BATTERY": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "БАТАРЕЯ"
          }
        }
      }
    },
