      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Батарея"
          }
        }
      }
    },
    "Battery %@": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Батарея %@"
          }
        }
      }
    },
    "Battery IP": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "IP батареї"
          }
        }
      }
    },
