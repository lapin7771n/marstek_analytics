{
	"Name": "Marstek Battery",
	"Version": "0.1.0.0",
	"Author": "Nikita Lapin",
	"Description": "Shows the charge level of a Marstek Venus battery and the time until it is full or empty.",
	"Category": "Marstek Battery",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"UUID": "com.mlapin.marstek",
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Actions": [
		{
			"Name": "Battery level",
			"UUID": "com.mlapin.marstek.level",
			"Icon": "imgs/actions/battery/icon",
			"Tooltip": "Charge percent and current power.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/battery/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Battery ETA",
			"UUID": "com.mlapin.marstek.eta",
			"Icon": "imgs/actions/battery/icon",
			"Tooltip": "Time until full while charging, time until empty while discharging.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/battery/key",
					"TitleAlignment": "middle"
				}
			]
		}
	]
}
